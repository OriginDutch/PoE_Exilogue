{
  "name": "exilogue",
  "version": "0.7.0",
  "description": "Path of Exile league compendium",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/tracker.test.js test/db.test.js test/logwatcher.test.js test/icons.test.js test/wealth.test.js test/ninja.test.js test/wesync.test.js test/pob.test.js",
    "mockups": "python3 tools/screenshots.py",
    "package": "electron-packager . Exilogue --platform=win32 --arch=x64 --out=dist --overwrite --ignore=^/mockups --ignore=^/tools --ignore=^/test --ignore=^/dist --ignore=^/build",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "author": "Marcel",
  "license": "UNLICENSED",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "electron-updater": "^6.8.11"
  },
  "productName": "Exilogue",
  "build": {
    "appId": "nl.terriblelizard.exilogue",
    "productName": "Exilogue",
    "directories": {
      "output": "release",
      "buildResources": "build-res"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!src/renderer/mock-v05.html"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Exilogue",
      "deleteAppDataOnUninstall": false,
      "include": "build-res/installer.nsh",
      "artifactName": "Exilogue-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "OriginDutch",
        "repo": "PoE_Exilogue",
        "releaseType": "release"
      }
    ]
  }
}